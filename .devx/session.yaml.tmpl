session_name: SB Heartbeat - {{.Name}}
start_directory: {{.Path}}
suppress_history: false
options:
  base-index: 1
  automatic-rename: "off"
  mouse: on
  status: on
  status-interval: 5
  status-left-length: 60
  status-right-length: 120
  status-left: '#[bold]SB Heartbeat - #{session_name}#[default] | #{window_index}:#{window_name}'
  status-right: '#{pane_current_path} | %Y-%m-%d %H:%M'
window_options:
  window-status-format: ' #{window_index}:#{window_name} '
  window-status-current-format: ' #[reverse]#{window_index}:#{window_name}#[default] '
windows:
  - window_name: agent
    layout: tiled
    shell_command_before:
      - cd {{.Path}}{{range $name, $port := .Ports}}
      - export {{$name}}={{$port}}{{end}}
      - export SESSION_NAME={{.Name}}
    panes:
      - pi -c

  - window_name: codex
    layout: tiled
    shell_command_before:
      - cd {{.Path}}{{range $name, $port := .Ports}}
      - export {{$name}}={{$port}}{{end}}
      - export SESSION_NAME={{.Name}}
    panes:
      - codex resume --last || codex

  - window_name: database
    layout: main-horizontal
    shell_command_before:
      - cd {{.Path}}{{range $name, $port := .Ports}}
      - export {{$name}}={{$port}}{{end}}
      - export SESSION_NAME={{.Name}}
      - export SB_HEARTBEAT_DEV_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:$POSTGRES/postgres?sslmode=disable
    panes:
      - pane_name: postgres
        shell_command: {{.Path}}/.devx/start_postgres.sh
      - pane_name: shell
        shell_command: >-
          echo "Disposable PostgreSQL: $SB_HEARTBEAT_DEV_DATABASE_URL" &&
          echo 'Full local smoke: .devx/smoke.sh' &&
          echo 'No real heartbeat commands are started automatically.' &&
          bash

  - window_name: tests
    layout: tiled
    shell_command_before:
      - cd {{.Path}}{{range $name, $port := .Ports}}
      - export {{$name}}={{$port}}{{end}}
      - export SESSION_NAME={{.Name}}
    panes:
      - echo 'Go checks: test -z "$(gofmt -l .)" && go test ./... && go test -race ./... && go vet ./...' && bash
      - echo 'Disposable integration: .devx/smoke.sh' && bash
      - echo 'Docs checks: go test ./internal/documentation && npx --yes markdownlint-cli2@0.23.2' && bash
